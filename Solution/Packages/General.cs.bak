       public static List<vRetencion> getReporteRetenciones(DateTime desde, DateTime hasta, int? almacen, int? pventa, int? impuesto)
       {
           hasta = hasta.AddDays(1).Subtract(new TimeSpan(0, 0, 1));


           WhereParams parametros = new WhereParams();
           parametros = new WhereParams(" f.com_fecha BETWEEN {0} and {1} and r.com_tipodoc = {2} and r.com_estado = {3}  ", desde, hasta, Constantes.cRetencion.tpd_codigo, Constantes.cEstadoMayorizado);
           List<vRetencion> lst = vRetencionBLL.GetAll(parametros, "r.com_doctran");
           return lst;
